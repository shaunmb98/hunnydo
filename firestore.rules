rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything a homeowner owns lives under their own user document.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The pro side. No client reads or writes at all: every read and write goes
    // through the API routes with the admin SDK, which check who's asking.
    // That keeps homeowner uids and other businesses' bids private.
    match /businesses/{id}/{document=**} {
      allow read, write: if false;
    }
    match /openJobs/{id} {
      allow read, write: if false;
    }
  }
}
